# ============ plan_images_generations（方舟文生图） ============
# 方舟密钥，ark- 开头，必须显式配置（不做 ANTHROPIC_* 回退）
ARK_API_KEY=ark-xxx

# ============ tos_object_put（TOS 上传） ============
# auc_bigmodel_transcribe 传本地音频时也需要这四项
VOLC_TOS_ACCESS_KEY=your-access-key-id
VOLC_TOS_SECRET_KEY=your-secret-access-key
VOLC_TOS_BUCKET=your-bucket
VOLC_TOS_REGION=cn-beijing
# 可选
# VOLC_TOS_ENDPOINT=
# VOLC_TOS_PREFIX=volcengine-api-mcp

# ============ auc_bigmodel_transcribe（语音转写） ============
# 火山语音控制台 API Key
VOLC_ASR_API_KEY=xxx

# ============ askecho_web_search（联网搜索） ============
# 鉴权二选一：搜索 API Key，或火山 AK/SK（V4 签名）
ASK_ECHO_SEARCH_INFINITY_API_KEY=
# VOLCENGINE_ACCESS_KEY=your-access-key-id
# VOLCENGINE_SECRET_KEY=your-secret-access-key
